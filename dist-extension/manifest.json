{
  "manifest_version": 3,
  "name": "Braino \u2014 AI Browser Companion",
  "version": "8.8.1",
  "description": "Your AI companion that lives in the browser \u2014 record audio, chat about any page, and sync notes to Notion",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://trybraino.com/*",
      "https://braino-eight.vercel.app/*"
    ]
  },
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "toggle_movie_mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Toggle Movie Mode"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/elementMap.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "offscreen.js",
        "mic-permission.html",
        "mic-permission.js",
        "fonts/*",
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  }
}
