# Supabase — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Used by Supabase CLI / Edge Functions
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
# Optional legacy alias for local tools that still read this name
SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Spotify OAuth for Supabase Edge Functions
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>
SPOTIFY_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/spotify-oauth-callback

# OpenAI Realtime voice + vision
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
#sbp_d917f250144a68eb1dd1a86094d3df458854b867
#SUPABASE ACCESS TOKEN = 

# Optional override for Braino's hosted OpenAI web-search route
# OPENAI_WEB_SEARCH_MODEL=gpt-5.6-luna

# GitHub — Braino Dev Pulse (lets Braino know his own recent commits + when you worked on him).
# Use a fine-grained Personal Access Token scoped to ONLY this repo, with permissions
# Contents: Read-only + Metadata: Read-only. Nothing else.
GITHUB_TOKEN=<your-fine-grained-github-pat>
GITHUB_REPO=<owner>/<repo>
# Optional: branch Braino should read. Leave unset for the default branch (main).
# GITHUB_BRANCH=<your-active-branch>


