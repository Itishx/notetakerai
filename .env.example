# Supabase — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Used by Supabase CLI / Edge Functions
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
# Optional legacy alias for local tools that still read this name
SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Spotify OAuth for Supabase Edge Functions
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>
SPOTIFY_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/spotify-oauth-callback

# OpenAI Realtime voice + vision
OPENAI_API_KEY=<your-openai-api-key>
# Recommended for dashboard/org usage + cost reporting.
# Use an admin-capable key if your standard API key cannot access organization usage endpoints.
OPENAI_ADMIN_API_KEY=<your-openai-admin-api-key>
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
# Track dashboard spend from this UTC date forward.
# Set this to your app launch date or earlier if you want true lifetime totals.
OPENAI_COSTS_START_DATE=2024-01-01
# Optional: comma-separated OpenAI project IDs if you want dashboard spend scoped to one app/project.
# OPENAI_COSTS_PROJECT_IDS=proj_abc123,proj_def456

# Optional override for Braino's hosted OpenAI web-search route
# OPENAI_WEB_SEARCH_MODEL=gpt-5.5
