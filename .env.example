# Supabase — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Used by Supabase CLI / Edge Functions
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
# Optional legacy alias for local tools that still read this name
SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Spotify OAuth for Supabase Edge Functions
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>
SPOTIFY_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/spotify-oauth-callback

# Google Calendar OAuth for Supabase Edge Functions
# You can reuse the same Google Cloud OAuth client as Drive if it has these redirect URLs/scopes enabled.
GOOGLE_CALENDAR_CLIENT_ID=<your-google-calendar-client-id>
GOOGLE_CALENDAR_CLIENT_SECRET=<your-google-calendar-client-secret>
GOOGLE_CALENDAR_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/google-calendar-oauth-callback
GOOGLE_CALENDAR_PUSH_WEBHOOK_URL=https://<your-project-ref>.supabase.co/functions/v1/google-calendar-push-webhook

# OpenAI Realtime voice + vision
OPENAI_API_KEY=<your-openai-api-key>
# Recommended for dashboard/org usage + cost reporting.
# Use an admin-capable key if your standard API key cannot access organization usage endpoints.
OPENAI_ADMIN_API_KEY=<your-openai-admin-api-key>
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
# Track dashboard spend from this UTC date forward.
# Set this to your app launch date or earlier if you want true lifetime totals.
OPENAI_COSTS_START_DATE=2024-01-01
# Optional: comma-separated OpenAI project IDs if you want dashboard spend scoped to one app/project.
# OPENAI_COSTS_PROJECT_IDS=proj_abc123,proj_def456
# Comma-separated admin emails allowed to view /realtime-costs.
REALTIME_COSTS_ADMIN_EMAILS=itishpande21@gmail.com

# Optional override for Braino's hosted OpenAI web-search route
# OPENAI_WEB_SEARCH_MODEL=gpt-5.5

# Fish Audio TTS for Braino voice mode
FISH_AUDIO_API_KEY=<your-fish-audio-api-key>
FISH_AUDIO_MODEL=s2-pro
# Optional: set this to a Fish Audio voice/model id for a consistent custom Braino voice.
# FISH_AUDIO_REFERENCE_ID=<your-fish-audio-model-id>

# Fallback when Fish Audio API balance/key/rate limit fails. Uses the existing OPENAI_API_KEY.
ENABLE_OPENAI_TTS_FALLBACK=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# OPENAI_TTS_INSTRUCTIONS=Sound warm, direct, lively, and conversational.
