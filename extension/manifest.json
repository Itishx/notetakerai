{
  "manifest_version": 3,
  "name": "SideBrain — AI Browser Companion",
  "version": "1.3.0",
  "description": "Your AI companion that lives in the browser — record audio, chat about any page, and sync notes to Notion",
  "permissions": ["activeTab", "tabs", "tabCapture", "offscreen", "storage", "sidePanel", "scripting", "microphone"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["https://notetakerai.lovable.app/*", "https://*.lovable.app/*"]
  },
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
