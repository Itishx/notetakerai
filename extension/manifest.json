{
  "manifest_version": 3,
  "name": "LectureSnap — AI Lecture Notes",
  "version": "1.1.0",
  "description": "Record tab audio from Udemy, DataCamp, YouTube and convert to beautiful AI-powered notes",
  "permissions": ["activeTab", "tabs", "tabCapture", "offscreen", "storage", "sidePanel", "<all_urls>"],
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
