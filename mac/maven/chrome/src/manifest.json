{
  "manifest_version": 3,
  "name": "Maven",
  "short_name": "Maven",
  "version": "1.0.1",
  "description": "Talk instead of typing, in any text box. Control+Option to write, Option+Command to do.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Maven",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "welcome.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "island.html",
        "island.css",
        "island.js",
        "island-shim.js",
        "maven-character.js",
        "vendor/affectiveos-voice.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://affctve.com/*",
      "https://www.affctve.com/*",
      "https://trybraino.com/*",
      "https://www.trybraino.com/*"
    ]
  }
}