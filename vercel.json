{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "trybraino.com"
        }
      ],
      "destination": "https://www.affctve.com/braino",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.trybraino.com"
        }
      ],
      "destination": "https://www.affctve.com/braino",
      "permanent": false
    },
    {
      "source": "/waitlist",
      "destination": "/braino#early-access",
      "permanent": false
    },
    {
      "source": "/early-access",
      "destination": "/braino#early-access",
      "permanent": false
    },
    {
      "source": "/apps",
      "destination": "/braino",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/affectiveos",
      "destination": "/affectiveos/index.html"
    },
    {
      "source": "/braino",
      "destination": "/braino/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
